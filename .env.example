# ==============================================================================
# SIGO-Dental - Variables de Entorno de Configuración
# Copiar este archivo a .env en el servidor self-hosted para personalizar
# ==============================================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=sigo_dental
POSTGRES_USER=sigo
POSTGRES_PASSWORD=sigo_password_change_me
PORT_POSTGRES=5432

# Configuración de Redis Cache
PORT_REDIS=6379
SIGO_REDIS=redis:6379

# Configuración del Backend (Go)
SIGO_DB=postgres://sigo:sigo_password_change_me@postgres:5432/sigo_dental?sslmode=disable
SIGO_ADDR=:8080
SIGO_JWT_SECRET=sigo-production-secret-change-me
PORT_BACKEND=8080

# Configuración del Frontend (React + Nginx)
PORT_FRONTEND=80
